# Application
APP_NAME=Telemetry Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Telemetry
TELEMETRY_RATE=10
MAX_TELEMETRY_RATE=100
MAX_HISTORY_SIZE=5000

# Anomaly Detection
ANOMALY_Z_THRESHOLD=3.0

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
