# Application
APP_NAME=Telemetry Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://telemetry:telemetry@localhost:5432/telemetry
DATABASE_ECHO=false

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-password

# Telemetry
TELEMETRY_RATE=10
MAX_TELEMETRY_RATE=100
MAX_HISTORY_SIZE=5000
TELEMETRY_PERSISTENCE_ENABLED=true
TELEMETRY_HOST_NAME=synthetic-local
TELEMETRY_HOST_ENVIRONMENT=development

# Anomaly Detection
ANOMALY_Z_THRESHOLD=3.0

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
