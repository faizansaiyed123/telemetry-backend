# Application
APP_NAME=Telemetry Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://telemetry:telemetry@localhost:5432/telemetry
DATABASE_ECHO=false

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-password

# Telemetry
# hybrid keeps the existing simulator available while accepting real agent data.
# agent disables synthetic generation and makes the UI/backend ingest real host data only.
TELEMETRY_SOURCE_MODE=hybrid
TELEMETRY_RATE=10
MAX_TELEMETRY_RATE=100
MAX_HISTORY_SIZE=5000
TELEMETRY_PERSISTENCE_ENABLED=true
TELEMETRY_HOST_NAME=synthetic-local
TELEMETRY_HOST_ENVIRONMENT=development

# Distributed WebSocket fan-out (optional)
# Enable only when multiple backend worker processes need shared live delivery.
DISTRIBUTED_EVENT_FANOUT_ENABLED=false
DISTRIBUTED_EVENT_CHANNEL=telemetry_platform_events
DISTRIBUTED_EVENT_QUEUE_SIZE=2000

# Anomaly Detection
ANOMALY_Z_THRESHOLD=3.0

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
